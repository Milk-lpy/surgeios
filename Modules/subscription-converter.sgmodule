#!name=Surge Subscription Studio 6
#!desc=Surge 6 本机订阅转换器：SS / AnyTLS / VLESS（REALITY、Vision、XHTTP、gRPC）/ Trojan / VMess / Hysteria 2 / TUIC 和原生 Surge 节点。遇到不支持的参数拒绝丢参；失败沿用上次缓存，原始订阅 URL 不写入仓库。

[General]
force-http-engine-hosts = %APPEND% surge-converter.test

[Host]
surge-converter.test = 127.0.0.1

[Script]
Subscription Studio 设置 = type=http-request, pattern=^http://surge-converter\.test/api/source(?:\?|$), script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v3.js, script-update-interval=3600, requires-body=true, max-size=65536, timeout=15
Subscription Studio 主服务 = type=http-request, pattern=^http://surge-converter\.test(?:/|$), script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v3.js, script-update-interval=3600, timeout=30
打开 Subscription Studio = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v3.js, script-update-interval=3600, argument="__OPEN_WEB__", timeout=5
复制当前节点 = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v3.js, script-update-interval=3600, argument="__COPY_CACHE__", timeout=10
