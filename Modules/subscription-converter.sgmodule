#!name=Surge Subscription Studio
#!desc=本机订阅转换器：在网页中输入原订阅，URL 仅保存于 Surge Persistent Store；将 Base64/明文 ss:// + anytls:// 转为 Surge 原生代理列表，并提供 http://surge-converter.test/subscription 作为本机 policy-path 输出。

[General]
force-http-engine-hosts = %APPEND% surge-converter.test

[Host]
surge-converter.test = 127.0.0.1

[Script]
Subscription Studio 设置 = type=http-request, pattern=^http://surge-converter\.test/api/source(?:\?|$), script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v2.js, script-update-interval=3600, requires-body=true, max-size=65536, timeout=15
Subscription Studio 主服务 = type=http-request, pattern=^http://surge-converter\.test(?:/|$), script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v2.js, script-update-interval=3600, timeout=30
打开 Subscription Studio = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v2.js, script-update-interval=3600, argument="__OPEN_WEB__", timeout=5
复制当前节点 = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-studio-v2.js, script-update-interval=3600, argument="__COPY_CACHE__", timeout=10
