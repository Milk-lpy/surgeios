#!name=Surge 订阅转换助手
#!desc=原始 Base64/明文 ss:// + anytls:// 订阅转换器，附带本地劫持前端。Safari 打开 http://surge-converter.test/ 即可查看统计、刷新转换、预览和复制节点。不会在前端显示订阅 Token。
#!arguments=subscription_url:
#!arguments-desc=填入不带 subType=surge 的原始通用订阅 URL。不要把含 Token 的地址提交到公开仓库。

[General]
force-http-engine-hosts = %APPEND% surge-converter.test

[Host]
surge-converter.test = 127.0.0.1

[Script]
订阅转换前端 = type=http-request, pattern=^http://surge-converter\.test(?:/|$), script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-converter.js, script-update-interval=3600, argument="{{{subscription_url}}}", timeout=30
打开转换前端 = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-converter.js, script-update-interval=3600, argument="__OPEN_WEB__", timeout=5
订阅转换并复制 = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-converter.js, script-update-interval=3600, argument="{{{subscription_url}}}", timeout=30
复制上次转换结果 = type=generic, script-path=https://raw.githubusercontent.com/Milk-lpy/surgeios/main/Scripts/subscription-converter.js, script-update-interval=3600, argument="__COPY_CACHE__", timeout=10
